@model MSDentalSys.Models.PacienteFormViewModel
@{
    ViewData["Title"] = "Editar paciente";
    ViewData["FormAction"] = "Edit";
}

<div class="patient-page">
    <div class="page-heading patient-form-heading">
        <div>
            <p class="dashboard-eyebrow">Pacientes</p>
            <h1>Editar paciente</h1>
            <p>Actualiza los datos personales y antecedentes clínicos.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.PacienteId" class="btn btn-light">Ver detalles</a>
    </div>

    <div class="patient-form-card">
        <partial name="_PacienteForm" model="Model" view-data="ViewData" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
