@model MSDentalSys.Models.Paciente
@{
    ViewData["Title"] = "Detalle del paciente";
}

<div class="patient-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Ficha del paciente</p>
            <h1>@Model.Nombre @Model.Apellido</h1>
            <p>Información personal y antecedentes clínicos básicos.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-light">Volver</a>
            <a asp-action="Edit" asp-route-id="@Model.PacienteId" class="btn btn-ms-primary">Editar paciente</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="detail-card h-100">
                <div class="detail-card-heading">
                    <h2>Datos personales</h2>
                    <span class="status-badge @(Model.Estado ? "status-active" : "status-inactive")">@(Model.Estado ? "Activo" : "Inactivo")</span>
                </div>
                <dl class="detail-grid">
                    <div><dt>Nombre completo</dt><dd>@Model.Nombre @Model.Apellido</dd></div>
                    <div><dt>Cédula</dt><dd>@(Model.Cedula ?? "No especificada")</dd></div>
                    <div><dt>Fecha de nacimiento</dt><dd>@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No especificada")</dd></div>
                    <div><dt>Sexo</dt><dd>@(Model.Sexo ?? "No especificado")</dd></div>
                    <div><dt>Teléfono</dt><dd>@(Model.Telefono ?? "No especificado")</dd></div>
                    <div><dt>Correo electrónico</dt><dd>@(Model.Correo ?? "No especificado")</dd></div>
                    <div class="detail-full"><dt>Dirección</dt><dd>@(Model.Direccion ?? "No especificada")</dd></div>
                    <div><dt>Contacto de emergencia</dt><dd>@(Model.ContactoEmergencia ?? "No especificado")</dd></div>
                    <div><dt>Teléfono de emergencia</dt><dd>@(Model.TelefonoEmergencia ?? "No especificado")</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="detail-card h-100">
                <div class="detail-card-heading">
                    <h2>Antecedentes clínicos</h2>
                </div>
                <dl class="detail-list">
                    <div><dt>Alergias</dt><dd>@(Model.AntecedenteClinico?.Alergias ?? "No registradas")</dd></div>
                    <div><dt>Enfermedades sistémicas</dt><dd>@(Model.AntecedenteClinico?.EnfermedadesSistemicas ?? "No registradas")</dd></div>
                    <div><dt>Medicamentos actuales</dt><dd>@(Model.AntecedenteClinico?.MedicamentosActuales ?? "No registrados")</dd></div>
                    <div><dt>Cirugías previas</dt><dd>@(Model.AntecedenteClinico?.CirugiasPrevias ?? "No registradas")</dd></div>
                    <div><dt>Hábitos relevantes</dt><dd>@(Model.AntecedenteClinico?.HabitosRelevantes ?? "No registrados")</dd></div>
                    <div><dt>Embarazo</dt><dd>@(Model.AntecedenteClinico?.Embarazo is true ? "Sí" : Model.AntecedenteClinico?.Embarazo is false ? "No" : "No especificado")</dd></div>
                    <div><dt>Observaciones</dt><dd>@(Model.AntecedenteClinico?.Observaciones ?? "Sin observaciones")</dd></div>
                </dl>
            </div>
        </div>
    </div>
</div>
