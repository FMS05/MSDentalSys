@model MSDentalSys.Models.ServicioFormViewModel
@{
    ViewData["Title"] = "Crear servicio";
}

<div class="service-page">
    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Catálogo clínico</p>
            <h1>Crear servicio</h1>
            <p>Agrega un servicio para utilizarlo en el registro de citas.</p>
        </div>
        <a asp-action="Index" class="btn btn-light">Volver a servicios</a>
    </div>

    <div class="service-form-card">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-4">
                <div class="col-md-7">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="DuracionEstimadaMinutos" class="form-label"></label>
                    <input asp-for="DuracionEstimadaMinutos" class="form-control" autocomplete="off" min="1" max="1440" />
                    <span asp-validation-for="DuracionEstimadaMinutos" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" autocomplete="off" rows="4"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-ms-primary">Crear servicio</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
