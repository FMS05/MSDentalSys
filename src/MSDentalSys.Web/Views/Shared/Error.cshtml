@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">No se pudo completar la solicitud.</h1>
<p>Inténtalo de nuevo. Si el problema continúa, comunica el identificador de solicitud al administrador.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}
