@model IEnumerable<MSDentalSys.Data.Models.Cita>
@{
    ViewData["Title"] = "Citas";
    var selectedDate = ViewData["Fecha"]?.ToString();
    var selectedStatus = ViewData["Estado"]?.ToString();
    var selectedPatientId = ViewData["PacienteId"] as int?;
    var selectedPatientName = ViewData["PacienteNombre"]?.ToString() ?? string.Empty;
    var statuses = new[] { "Pendiente", "Confirmada", "Atendida", "Cancelada", "No asistió" };
}

<div class="appointment-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Agenda clínica</p>
            <h1>Citas</h1>
            <p>Organiza y consulta las citas de la clínica.</p>
        </div>
        @if (!User.IsInRole("Odontologo"))
        {
            <a asp-action="Create" class="btn btn-ms-primary"><span aria-hidden="true">+</span> Nueva cita</a>
        }
    </div>

    <div class="appointment-filters">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label for="fecha" class="form-label">Fecha</label>
                <input type="date" id="fecha" name="fecha" value="@selectedDate" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label for="estado" class="form-label">Estado</label>
                <select id="estado" name="estado" class="form-select">
                    <option value="">Todos los estados</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status" selected="@(selectedStatus == status ? "selected" : null)">@status</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label for="PacienteBusqueda" class="form-label">Paciente</label>
                <input id="pacienteId" name="pacienteId" type="hidden" value="@(selectedPatientId?.ToString() ?? string.Empty)" />
                <input id="PacienteBusqueda" name="PacienteNombre" value="@selectedPatientName" class="form-control" autocomplete="off" placeholder="Buscar por nombre, apellido o c&eacute;dula..." aria-controls="patient-search-results" aria-autocomplete="list" />
                <div id="patient-search-results" class="list-group mt-2" role="listbox" hidden></div>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-ms-primary flex-grow-1">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">×</a>
            </div>
        </form>
    </div>

    <div class="appointment-table-card">
        <div class="table-responsive">
            <table class="table appointment-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Paciente</th>
                        <th>Odontólogo</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cita in Model)
                    {
                        <tr>
                            <td>
                                <strong class="appointment-date">@cita.FechaHoraInicio.ToString("dd/MM/yyyy")</strong>
                                <span class="appointment-time">@cita.FechaHoraInicio.ToString("hh:mm tt")</span>
                            </td>
                            <td>@cita.Paciente.Nombre @cita.Paciente.Apellido</td>
                            <td>@cita.Odontologo.Nombre @cita.Odontologo.Apellido</td>
                            <td>@cita.ServicioOdontologico.Nombre</td>
                            <td><span class="appointment-status status-@cita.EstadoCita.ToLowerInvariant().Replace(" ", "-")">@cita.EstadoCita</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@cita.CitaId" class="btn btn-sm btn-action">Ver</a>
                                @if ((User.IsInRole("Administrador") || User.IsInRole("Recepcionista")) && cita.EstadoCita != "Cancelada" && cita.EstadoCita != "Atendida")
                                {
                                    <a asp-action="Reschedule" asp-route-id="@cita.CitaId" class="btn btn-sm btn-action">Reagendar</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-table">No se encontraron citas con los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('PacienteBusqueda');
            const hiddenId = document.getElementById('pacienteId');
            const results = document.getElementById('patient-search-results');
            const form = search?.form;
            const endpoint = '@Url.Action("BuscarPacientesParaFiltro", "Citas")';
            let timer;
            let pending;

            const cancelSearch = () => {
                clearTimeout(timer);
                pending?.abort();
                pending = null;
            };
            let selectedName = search?.value ?? '';

            const clearResults = () => {
                if (!results) return;
                results.innerHTML = '';
                results.hidden = true;
            };

            const renderResults = (patients) => {
                if (!results) return;
                results.innerHTML = '';

                if (patients.length === 0) {
                    results.hidden = true;
                    return;
                }

                patients.forEach(patient => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'list-group-item list-group-item-action';
                    option.setAttribute('role', 'option');
                    const name = document.createElement('strong');
                    name.textContent = patient.nombreCompleto;
                    const lineBreak = document.createElement('br');
                    const documentId = document.createElement('small');
                    documentId.textContent = patient.cedula ? `Cédula: ${patient.cedula}` : 'Cédula: No registrada';
                    option.append(name, lineBreak, documentId);
                    option.addEventListener('click', () => {
                        cancelSearch();
                        search.value = patient.nombreCompleto;
                        selectedName = patient.nombreCompleto;
                        hiddenId.value = patient.id;
                        clearResults();
                    });
                    results.appendChild(option);
                });

                results.hidden = false;
            };

            search?.addEventListener('input', () => {
                cancelSearch();
                clearResults();
                if (search.value !== selectedName) hiddenId.value = '';

                const term = search.value.trim();
                if (term.length < 1) return;

                const request = new AbortController();
                pending = request;
                const isCurrent = () => pending === request && search.value.trim() === term;
                timer = setTimeout(async () => {
                    if (!isCurrent()) return;
                    try {
                        const response = await fetch(`${endpoint}?termino=${encodeURIComponent(term)}`, { signal: request.signal });
                        if (response.ok) {
                            const patients = await response.json();
                            if (isCurrent()) renderResults(patients);
                        }
                    } catch (error) {
                        if (error.name === 'AbortError' || !isCurrent()) return;
                        clearResults();
                    }
                }, 300);
            });

            form?.addEventListener('submit', () => {
                if (!search.value.trim() || search.value !== selectedName) hiddenId.value = '';
            });

            document.addEventListener('click', event => {
                if (!results?.contains(event.target) && event.target !== search) {
                    cancelSearch();
                    clearResults();
                }
            });
        })();
    </script>
}
