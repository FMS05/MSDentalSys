@model IEnumerable<MSDentalSys.Data.Models.Cita>
@{
    ViewData["Title"] = "Citas";
    var selectedDate = ViewData["Fecha"]?.ToString();
    var selectedStatus = ViewData["Estado"]?.ToString();
    var selectedPatientId = ViewData["PacienteId"] as int?;
    var selectedPatientName = ViewData["PacienteNombre"]?.ToString() ?? string.Empty;
    var selectedDentistId = ViewData["OdontologoId"]?.ToString();
    var dentists = ViewData["Odontologos"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var selectedView = ViewData["Vista"]?.ToString() == "lista" ? "lista" : "calendario";
    var isCalendar = selectedView == "calendario";
    var canChooseDentist = !User.IsInRole("Odontologo")
        && (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"));
    var statuses = new[] { "Pendiente", "Confirmada", "Atendida", "Cancelada", "No asistió" };
}

<link rel="stylesheet" href="~/css/citas-calendario.css" asp-append-version="true" />

<div class="appointment-page citas-calendar-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Agenda clínica</p>
            <h1>Citas</h1>
            <p>Organiza y consulta las citas de la clínica.</p>
        </div>
        @if (!User.IsInRole("Odontologo"))
        {
            <a asp-action="Create" class="btn btn-ms-primary"><span aria-hidden="true">+</span> Nueva cita</a>
        }
    </div>

    <div class="appointment-filters">
        <form id="citas-filtros" asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="vista" value="@selectedView" />
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="fecha" class="form-label">Fecha</label>
                <input type="date" id="fecha" name="fecha" value="@selectedDate" class="form-control" aria-describedby="@(isCalendar ? "calendario-fecha-ayuda" : null)" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="estado" class="form-label">Estado</label>
                <select id="estado" name="estado" class="form-select">
                    <option value="">Todos los estados</option>
                    @foreach (var status in statuses)
                    {
                        <option value="@status" selected="@(selectedStatus == status ? "selected" : null)">@status</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="PacienteBusqueda" class="form-label">Paciente</label>
                <input id="pacienteId" name="pacienteId" type="hidden" value="@(selectedPatientId?.ToString() ?? string.Empty)" />
                <input id="PacienteBusqueda" name="PacienteNombre" value="@selectedPatientName" class="form-control" autocomplete="off" placeholder="Buscar por nombre, apellido o c&eacute;dula..." aria-controls="patient-search-results" aria-autocomplete="list" />
                <div id="patient-search-results" class="list-group mt-2" role="listbox" hidden></div>
            </div>
            @if (canChooseDentist)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="odontologoId" class="form-label">Odontólogo</label>
                    <select id="odontologoId" name="odontologoId" class="form-select">
                        <option value="">Todos los odontólogos</option>
                        @foreach (var dentist in dentists)
                        {
                            <option value="@dentist.Value" selected="@(selectedDentistId == dentist.Value ? "selected" : null)">@dentist.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-12 col-md-auto col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-ms-primary flex-grow-1">Filtrar</button>
                <a asp-action="Index" asp-route-vista="@selectedView" class="btn btn-outline-secondary" title="Limpiar filtros" aria-label="Limpiar filtros">×</a>
            </div>
        </form>
    </div>

    <nav class="calendar-view-switch mb-3" aria-label="Visualización de citas">
        <a asp-action="Index" asp-route-vista="calendario" asp-route-fecha="@selectedDate" asp-route-estado="@selectedStatus" asp-route-pacienteId="@selectedPatientId" asp-route-odontologoId="@selectedDentistId"
           class="btn @(isCalendar ? "btn-ms-primary" : "btn-outline-secondary")" aria-current="@(isCalendar ? "page" : null)" data-calendar-view="calendario">Calendario</a>
        <a asp-action="Index" asp-route-vista="lista" asp-route-fecha="@selectedDate" asp-route-estado="@selectedStatus" asp-route-pacienteId="@selectedPatientId" asp-route-odontologoId="@selectedDentistId"
           class="btn @(!isCalendar ? "btn-ms-primary" : "btn-outline-secondary")" aria-current="@(!isCalendar ? "page" : null)" data-calendar-view="lista">Lista</a>
    </nav>

    @if (isCalendar)
    {
        <section class="appointment-calendar-card" aria-label="Calendario de citas">
            <p class="calendar-guidance">Consulta las citas registradas y abre sus detalles al seleccionarlas. Los espacios vacíos y los filtros no garantizan disponibilidad.</p>
            <p id="calendario-fecha-ayuda" class="calendar-duration-note">Fecha sitúa el calendario en el período elegido; en Lista filtra las citas de ese día.</p>
            <p class="calendar-duration-note">“Duración no registrada”: se muestra un bloque visual de 15 minutos; su duración clínica es desconocida. Las canceladas son historial y no ocupan agenda.</p>
            <div id="calendario-error" class="alert alert-danger" role="alert" hidden>
                <span id="calendario-error-texto">No se pudieron cargar las citas.</span>
                <button id="calendario-reintentar" type="button" class="btn btn-sm btn-outline-danger ms-2">Reintentar</button>
            </div>
            <p id="calendario-estado" class="calendar-query-status" role="status" aria-live="polite"></p>
            <noscript><p class="alert alert-warning">Activa JavaScript para consultar el calendario o utiliza la vista Lista.</p></noscript>
            <div id="citas-calendario" data-endpoint="@Url.Action("Calendario", "Citas")" data-fecha="@selectedDate" aria-label="Agenda mensual y semanal"></div>
        </section>
    }

    <div class="appointment-table-card" hidden="@(isCalendar ? "hidden" : null)">
        <div class="table-responsive">
            <table class="table appointment-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Paciente</th>
                        <th>Odontólogo</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cita in Model)
                    {
                        <tr>
                            <td>
                                <strong class="appointment-date">@cita.FechaHoraInicio.ToString("dd/MM/yyyy")</strong>
                                <span class="appointment-time">@cita.FechaHoraInicio.ToString("hh:mm tt")</span>
                            </td>
                            <td>@cita.Paciente.Nombre @cita.Paciente.Apellido</td>
                            <td>@cita.Odontologo.Nombre @cita.Odontologo.Apellido</td>
                            <td>@cita.ServicioOdontologico.Nombre</td>
                            <td><span class="appointment-status status-@cita.EstadoCita.ToLowerInvariant().Replace(" ", "-")">@cita.EstadoCita</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@cita.CitaId" class="btn btn-sm btn-action">Ver</a>
                                @if ((User.IsInRole("Administrador") || User.IsInRole("Recepcionista")) && cita.EstadoCita != "Cancelada" && cita.EstadoCita != "Atendida")
                                {
                                    <a asp-action="Reschedule" asp-route-id="@cita.CitaId" class="btn btn-sm btn-action">Reagendar</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-table">No se encontraron citas con los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('PacienteBusqueda');
            const hiddenId = document.getElementById('pacienteId');
            const results = document.getElementById('patient-search-results');
            const form = search?.form;
            const endpoint = '@Url.Action("BuscarPacientesParaFiltro", "Citas")';
            let timer;
            let pending;

            const cancelSearch = () => {
                clearTimeout(timer);
                pending?.abort();
                pending = null;
            };
            let selectedName = search?.value ?? '';

            const clearResults = () => {
                if (!results) return;
                results.innerHTML = '';
                results.hidden = true;
            };

            const renderResults = (patients) => {
                if (!results) return;
                results.innerHTML = '';

                if (patients.length === 0) {
                    results.hidden = true;
                    return;
                }

                patients.forEach(patient => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'list-group-item list-group-item-action';
                    option.setAttribute('role', 'option');
                    const name = document.createElement('strong');
                    name.textContent = patient.nombreCompleto;
                    const lineBreak = document.createElement('br');
                    const documentId = document.createElement('small');
                    documentId.textContent = patient.cedula ? `Cédula: ${patient.cedula}` : 'Cédula: No registrada';
                    option.append(name, lineBreak, documentId);
                    option.addEventListener('click', () => {
                        cancelSearch();
                        search.value = patient.nombreCompleto;
                        selectedName = patient.nombreCompleto;
                        hiddenId.value = patient.id;
                        hiddenId.dispatchEvent(new Event('change', { bubbles: true }));
                        clearResults();
                    });
                    results.appendChild(option);
                });

                results.hidden = false;
            };

            search?.addEventListener('input', () => {
                cancelSearch();
                clearResults();
                if (search.value !== selectedName && hiddenId.value) {
                    hiddenId.value = '';
                    hiddenId.dispatchEvent(new Event('change', { bubbles: true }));
                }

                const term = search.value.trim();
                if (term.length < 1) return;

                const request = new AbortController();
                pending = request;
                const isCurrent = () => pending === request && search.value.trim() === term;
                timer = setTimeout(async () => {
                    if (!isCurrent()) return;
                    try {
                        const response = await fetch(`${endpoint}?termino=${encodeURIComponent(term)}`, { signal: request.signal });
                        if (response.ok) {
                            const patients = await response.json();
                            if (isCurrent()) renderResults(patients);
                        }
                    } catch (error) {
                        if (error.name === 'AbortError' || !isCurrent()) return;
                        clearResults();
                    }
                }, 300);
            });

            form?.addEventListener('submit', () => {
                if ((!search.value.trim() || search.value !== selectedName) && hiddenId.value) {
                    hiddenId.value = '';
                    hiddenId.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });

            document.addEventListener('click', event => {
                if (!results?.contains(event.target) && event.target !== search) {
                    cancelSearch();
                    clearResults();
                }
            });
        })();
    </script>
    @if (isCalendar)
    {
        <script src="~/lib/fullcalendar/core/index.global.min.js" asp-append-version="true"></script>
        <script src="~/lib/fullcalendar/daygrid/index.global.min.js" asp-append-version="true"></script>
        <script src="~/lib/fullcalendar/timegrid/index.global.min.js" asp-append-version="true"></script>
        <script src="~/lib/fullcalendar/core/locales/es.global.min.js" asp-append-version="true"></script>
    }
    <script src="~/js/citas-calendario.js" asp-append-version="true"></script>
}
