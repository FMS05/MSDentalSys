@model MSDentalSys.Web.Models.ViewModels.CitaFormViewModel
@{
    ViewData["Title"] = "Registrar cita";
}

<div class="appointment-page">
    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Agenda clínica</p>
            <h1>Registrar cita</h1>
            <p>Programa una nueva cita para un paciente.</p>
        </div>
        <a asp-action="Index" class="btn btn-light">Volver a citas</a>
    </div>

    <div class="appointment-form-card">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="PacienteId" class="form-label"></label>
                    <input asp-for="PacienteId" type="hidden" />
                    <input id="PacienteBusqueda" name="PacienteNombre" value="@Model.PacienteNombre" class="form-control" autocomplete="off" placeholder="Buscar por nombre, apellido o c&eacute;dula..." aria-controls="patient-search-results" aria-autocomplete="list" />
                    <div id="patient-search-results" class="list-group mt-2" role="listbox" hidden></div>
                    <span asp-validation-for="PacienteId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="OdontologoId" class="form-label"></label>
                    <select asp-for="OdontologoId" asp-items="Model.Odontologos" class="form-select" autocomplete="off">
                        <option value="">Selecciona un odontólogo</option>
                    </select>
                    <span asp-validation-for="OdontologoId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ServicioOdontologicoId" class="form-label"></label>
                    <select asp-for="ServicioOdontologicoId" asp-items="Model.Servicios" class="form-select" autocomplete="off">
                        <option value="">Selecciona un servicio</option>
                    </select>
                    <span asp-validation-for="ServicioOdontologicoId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SubservicioOdontologicoId" class="form-label"></label>
                    <select asp-for="SubservicioOdontologicoId" asp-items="Model.Subservicios" class="form-select"
                            disabled="@(!Model.Subservicios.Any())" data-endpoint="@Url.Action("ParaCitas", "Subservicios")" aria-describedby="subservicios-status">
                        <option value="">Seleccione un subservicio</option>
                    </select>
                    <span asp-validation-for="SubservicioOdontologicoId" class="text-danger"></span>
                    <small id="subservicios-status" class="text-muted" role="status"></small>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaHoraInicio" class="form-label"></label>
                    <input asp-for="FechaHoraInicio" class="form-control" autocomplete="off" type="datetime-local" />
                    <span asp-validation-for="FechaHoraInicio" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" autocomplete="off" rows="4" placeholder="Notas adicionales para la cita (opcional)"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-ms-primary">Registrar cita</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/citas-subservicios.js" asp-append-version="true"></script>
    <script>
        (() => {
            const search = document.getElementById('PacienteBusqueda');
            const hiddenId = document.getElementById('PacienteId');
            const results = document.getElementById('patient-search-results');
            const endpoint = '@Url.Action("BuscarPacientes", "Citas")';
            let timer;
            let selectedName = search?.value ?? '';

            const clearResults = () => {
                if (!results) return;
                results.innerHTML = '';
                results.hidden = true;
            };

            const renderResults = (patients) => {
                if (!results) return;
                results.innerHTML = '';

                if (patients.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'list-group-item text-muted';
                    empty.textContent = 'No se encontraron pacientes activos.';
                    results.appendChild(empty);
                    results.hidden = false;
                    return;
                }

                patients.forEach(patient => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'list-group-item list-group-item-action';
                    option.setAttribute('role', 'option');
                    const name = document.createElement('strong');
                    name.textContent = patient.nombreCompleto;
                    const lineBreak = document.createElement('br');
                    const documentId = document.createElement('small');
                    documentId.textContent = patient.cedula ? `Cédula: ${patient.cedula}` : 'Cédula: No registrada';
                    option.append(name, lineBreak, documentId);
                    option.addEventListener('click', () => {
                        search.value = patient.nombreCompleto;
                        selectedName = patient.nombreCompleto;
                        hiddenId.value = patient.id;
                        clearResults();
                    });
                    results.appendChild(option);
                });

                results.hidden = false;
            };

            search?.addEventListener('input', () => {
                if (search.value !== selectedName) hiddenId.value = '0';
                clearTimeout(timer);
                clearResults();

                const term = search.value.trim();
                if (term.length < 1) return;

                timer = setTimeout(async () => {
                    try {
                        const response = await fetch(`${endpoint}?termino=${encodeURIComponent(term)}`);
                        if (response.ok) renderResults(await response.json());
                    } catch {
                        clearResults();
                    }
                }, 300);
            });

            document.addEventListener('click', event => {
                if (!results?.contains(event.target) && event.target !== search) clearResults();
            });
        })();
    </script>
}
