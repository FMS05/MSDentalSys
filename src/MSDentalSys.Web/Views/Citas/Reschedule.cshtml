@model MSDentalSys.Web.Models.ViewModels.ReagendarCitaViewModel
@{
    ViewData["Title"] = "Reagendar cita";
}

<div class="appointment-page">
    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Agenda clínica</p>
            <h1>Reagendar cita</h1>
            <p>Solo se modificará la fecha y hora de la cita.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.CitaId" class="btn btn-light">Volver al detalle</a>
    </div>

    <div class="appointment-form-card appointment-reschedule-card">
        <form asp-action="Reschedule" asp-route-id="@Model.CitaId" method="post" autocomplete="off">
            <input asp-for="CitaId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <label asp-for="FechaHoraInicio" class="form-label"></label>
            <input asp-for="FechaHoraInicio" class="form-control" autocomplete="off" type="datetime-local" />
            <span asp-validation-for="FechaHoraInicio" class="text-danger"></span>
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Details" asp-route-id="@Model.CitaId" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-ms-primary">Guardar nueva fecha</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
