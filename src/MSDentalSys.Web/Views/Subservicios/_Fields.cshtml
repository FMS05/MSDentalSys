@model MSDentalSys.Web.Models.ViewModels.SubservicioFormViewModel
<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Clasificacion" class="form-label"></label><span aria-hidden="true"> *</span>
        <select asp-for="Clasificacion" asp-items="Html.GetEnumSelectList<MSDentalSys.Data.Models.ClasificacionSubservicio>()" class="form-select">
            <option value="">Seleccione...</option>
        </select>
        <span asp-validation-for="Clasificacion" class="text-danger"></span>
    </div>
    <div class="col-md-7"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
    <div class="col-md-5"><label asp-for="DuracionEstimadaMinutos" class="form-label"></label><input asp-for="DuracionEstimadaMinutos" class="form-control" min="1" max="1440" /><span asp-validation-for="DuracionEstimadaMinutos" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="4"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
</div>
