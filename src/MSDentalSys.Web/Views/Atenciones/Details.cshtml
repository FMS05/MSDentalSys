@model MSDentalSys.Data.Models.AtencionOdontologica
@{
    ViewData["Title"] = "Detalle de atención odontológica";
    var canAddDiagnosis = User.IsInRole("Administrador") ||
        (User.IsInRole("Odontologo") && Model.OdontologoId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
    var canManageTreatment = canAddDiagnosis;
    var canAddEvolution = canAddDiagnosis;
}

<div class="appointment-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Atención clínica</p>
            <h1>Detalle de atención odontológica</h1>
            <p>Registro clínico conservado para consulta.</p>
        </div>
        <a asp-controller="Citas" asp-action="Details" asp-route-id="@Model.CitaId" class="btn btn-light">Volver a la cita</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="appointment-detail-card">
                <dl class="appointment-detail-grid">
                    <div><dt>Paciente</dt><dd>@Model.Paciente.Nombre @Model.Paciente.Apellido</dd></div>
                    <div><dt>Odontólogo</dt><dd>@Model.Odontologo.Nombre @Model.Odontologo.Apellido</dd></div>
                    <div><dt>Cita</dt><dd>@(Model.Cita is null ? "Sin cita asociada" : Model.Cita.FechaHoraInicio.ToString("dd/MM/yyyy hh:mm tt"))</dd></div>
                    <div><dt>Fecha de atención</dt><dd>@Model.FechaAtencion.ToString("dd/MM/yyyy hh:mm tt")</dd></div>
                    <div class="detail-full"><dt>Motivo de consulta</dt><dd>@Model.MotivoConsulta</dd></div>
                    <div class="detail-full"><dt>Observaciones</dt><dd>@(Model.Observaciones ?? "Sin observaciones")</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="appointment-actions-card">
                <h2>Diagnósticos</h2>
                @if (Model.Diagnosticos.Count == 0)
                {
                    <p class="text-muted">No hay registros todavía.</p>
                }
                else
                {
                    foreach (var diagnostico in Model.Diagnosticos.OrderBy(d => d.DiagnosticoId))
                    {
                        <div class="border rounded p-3 mb-3">
                            <h3 class="h6 mb-2">@diagnostico.Descripcion</h3>
                            @if (!string.IsNullOrWhiteSpace(diagnostico.Observaciones))
                            {
                                <p class="text-muted mb-0">@diagnostico.Observaciones</p>
                            }
                        </div>
                    }
                }
                @if (canAddDiagnosis)
                {
                    <a asp-controller="Diagnosticos" asp-action="Create" asp-route-atencionId="@Model.AtencionOdontologicaId" class="btn btn-ms-primary w-100">Agregar diagnóstico</a>
                }
                <hr />
                <h2>Tratamientos</h2>
                @if (Model.Tratamientos.Count == 0)
                {
                    <p class="text-muted">No hay registros todavía.</p>
                }
                else
                {
                    foreach (var tratamiento in Model.Tratamientos.OrderBy(t => t.TratamientoId))
                    {
                        <div class="border rounded p-3 mb-3">
                            <h3 class="h6 mb-2">@(tratamiento.ServicioOdontologico?.Nombre ?? "Servicio no disponible")</h3>
                            <p class="mb-1"><strong>Inicio:</strong> @tratamiento.FechaInicio.ToString("dd/MM/yyyy")</p>
                            <p class="mb-2"><strong>Estado:</strong> @tratamiento.EstadoTratamiento</p>
                            @if (!string.IsNullOrWhiteSpace(tratamiento.Observaciones))
                            {
                                <p class="text-muted mb-2">@tratamiento.Observaciones</p>
                            }
                            @{
                                var allowedTreatmentStatuses = tratamiento.EstadoTratamiento switch
                                {
                                    "Planificado" => new[] { "En progreso", "Completado" },
                                    "En progreso" => new[] { "Completado" },
                                    _ => Array.Empty<string>()
                                };
                            }
                            @if (canManageTreatment && allowedTreatmentStatuses.Length > 0)
                            {
                                <form asp-controller="Tratamientos" asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@tratamiento.TratamientoId" />
                                    <select name="estado" class="form-select form-select-sm" autocomplete="off">
                                        @foreach (var allowedStatus in allowedTreatmentStatuses)
                                        {
                                            <option value="@allowedStatus">@allowedStatus</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">Actualizar</button>
                                </form>
                            }
                        </div>
                    }
                }
                @if (canManageTreatment)
                {
                    <a asp-controller="Tratamientos" asp-action="Create" asp-route-atencionId="@Model.AtencionOdontologicaId" class="btn btn-ms-primary w-100">Agregar tratamiento</a>
                }
                <hr />
                <h2>Evoluciones clínicas</h2>
                @if (Model.EvolucionesClinicas.Count == 0)
                {
                    <p class="text-muted">No hay registros todavía.</p>
                }
                else
                {
                    foreach (var evolucion in Model.EvolucionesClinicas.OrderByDescending(e => e.FechaEvolucion))
                    {
                        <div class="border rounded p-3 mb-3">
                            <p class="mb-2"><strong>Fecha:</strong> @evolucion.FechaEvolucion.ToString("dd/MM/yyyy hh:mm tt")</p>
                            <p class="mb-0">@evolucion.Descripcion</p>
                        </div>
                    }
                }
                @if (canAddEvolution)
                {
                    <a asp-controller="EvolucionesClinicas" asp-action="Create" asp-route-atencionId="@Model.AtencionOdontologicaId" class="btn btn-ms-primary w-100">Agregar evolución</a>
                }
            </div>
        </div>
    </div>
</div>
