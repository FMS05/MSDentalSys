@model MSDentalSys.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="user-admin-page">
    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Administración</p>
            <h1>Restablecer contraseña</h1>
            <p>Asigna una nueva contraseña a la cuenta seleccionada.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Volver</a>
    </div>

    <div class="user-form-card">
        <dl class="user-detail-grid">
            <div><dt>Usuario</dt><dd>@Model.NombreCompleto</dd></div>
            <div><dt>Correo electrónico</dt><dd>@Model.Email</dd></div>
            <div><dt>Estado</dt><dd>@(Model.Estado ? "Activo" : "Inactivo")</dd></div>
        </dl>
        <div class="alert alert-info" role="note">
            El usuario deberá utilizar la nueva contraseña. Sus sesiones anteriores serán invalidadas
            en la siguiente validación periódica de seguridad del sistema.
        </div>
        @if (!Model.Estado)
        {
            <div class="alert alert-warning" role="note">La cuenta continuará inactiva después del restablecimiento.</div>
        }
        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="user-form-section">
                <p class="user-form-help">La nueva contraseña debe cumplir la política de seguridad del sistema.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" value="" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" value="" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-ms-primary">Restablecer contraseña</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
