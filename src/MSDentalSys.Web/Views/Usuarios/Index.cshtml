@model MSDentalSys.Web.Models.ViewModels.UsuariosIndexViewModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="user-admin-page">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="page-heading">
        <div>
            <p class="dashboard-eyebrow">Administración</p>
            <h1>Usuarios internos</h1>
            <p>Gestiona el acceso del equipo de la clínica.</p>
        </div>
        <a asp-action="Create" class="btn btn-ms-primary"><span aria-hidden="true">+</span> Nuevo usuario</a>
    </div>

    <div class="user-toolbar">
        <form asp-action="Index" method="get" class="user-search-form">
            <div class="user-search-input">
                <span aria-hidden="true">&#128269;</span>
                <input type="search" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Buscar por nombre, apellido o correo..." aria-label="Buscar usuarios" />
            </div>
            <button type="submit" class="btn btn-ms-primary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </form>
        <span class="user-count">@Model.Usuarios.Count usuario(s)</span>
    </div>

    <div class="user-table-card">
        <div class="table-responsive">
            <table class="table user-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>
                                <div class="user-name-cell">
                                    <span class="user-avatar">@(string.IsNullOrWhiteSpace(usuario.NombreCompleto) ? "U" : usuario.NombreCompleto.Substring(0, 1).ToUpper())</span>
                                    <span>@usuario.NombreCompleto</span>
                                </div>
                            </td>
                            <td>@usuario.Email</td>
                            <td>@(usuario.Telefono ?? "—")</td>
                            <td><span class="role-badge role-@usuario.Rol.ToLowerInvariant()">@usuario.Rol</span></td>
                            <td><span class="user-status @(usuario.Estado ? "user-status-active" : "user-status-inactive")">@(usuario.Estado ? "Activo" : "Inactivo")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-user-action">Ver</a>
                                <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-user-action">Editar</a>
                                @if (!usuario.EsAdministradorInicial)
                                {
                                    @if (usuario.Estado)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@usuario.Id" method="post" class="d-inline" onsubmit="return confirm('¿Deseas desactivar este usuario?');">
                                            <button type="submit" class="btn btn-sm btn-user-action btn-user-danger">Desactivar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-user-action btn-user-activate">Activar</button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span class="protected-user-label">Protegido</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Usuarios.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="empty-table">No se encontraron usuarios con esos criterios.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
